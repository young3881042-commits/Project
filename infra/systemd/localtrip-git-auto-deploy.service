[Unit]
Description=LocalTrip git auto deploy
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=lezzs5103
WorkingDirectory=/home/lezzs5103/vibeCoding
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AUTO_DEPLOY_BRANCH=main
Environment=AUTO_DEPLOY_REMOTE=origin
Environment=AUTO_DEPLOY_COMPOSE_FILE=docker-compose.dev.yml
ExecStart=/home/lezzs5103/vibeCoding/scripts/git_auto_deploy.sh
