[Unit]
Description=LocalTrip Codex auto hunt and checklist deploy
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/lezzs5103/vibeCoding
Environment=AUTO_WORKTREE_DIR=/home/lezzs5103/vibeCoding-auto
Environment=BASE_BRANCH=main
Environment=CODEX_IMAGE=vibecoding-api
Environment=CODEX_HOME_DIR=/data/codex
Environment=CODEX_MODEL=gpt-5.5
Environment=CODEX_REASONING_EFFORT=high
ExecStart=/home/lezzs5103/vibeCoding/scripts/codex_auto_hunt.sh
