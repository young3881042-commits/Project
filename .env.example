# Docker Compose local-development settings.
# Copy this file to .env, then set both password values before starting Compose.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Optional port overrides. The defaults are suitable for a local machine.
HOST_BIND_ADDRESS=127.0.0.1
DB_PORT=3306
API_PORT=8080
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
NOTEBOOK_PORT=30888

# The browser reaches this Bridge address from the host, not from the web container.
VITE_LIFEHUB_BRIDGE_ADDRESS=http://127.0.0.1
VITE_LIFEHUB_BRIDGE_PORT=4317

# Keep server-side Codex execution disabled unless it has been reviewed for the target host.
ENABLE_TRAVEL_PLAN_CODEX_CLI_MODE=false
