{
  "name": "@lifehub/local-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "lifehub-bridge": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server-main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server-main.js",
    "cli": "tsx src/cli.ts",
    "pair": "tsx src/cli.ts pair create",
    "status": "tsx src/cli.ts status",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
