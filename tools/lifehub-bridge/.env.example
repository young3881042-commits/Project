# Keep loopback unless a trusted VPN or TLS reverse proxy protects the connection.
LIFEHUB_BRIDGE_LAN=0
LIFEHUB_BRIDGE_HOST=127.0.0.1
LIFEHUB_BRIDGE_PORT=4317
LIFEHUB_BRIDGE_ALLOWED_ORIGINS=capacitor://localhost,https://appassets.androidplatform.net

# Local/admin feature. Keep disabled unless the Bridge runs as a dedicated,
# least-privileged OS account behind a trusted HTTPS/VPN endpoint.
LIFEHUB_BRIDGE_REMOTE_COMMANDS=0
LIFEHUB_GIT_PUSH_HOSTS=github.com
